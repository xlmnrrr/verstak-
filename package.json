{
  "name": "kuhnya3d",
  "productName": "Верстак",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Верстак: 3D-конструктор встроенной и корпусной мебели под размеры помещения",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4173",
    "app": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "ru.xlmnr.kuhnya3d",
    "productName": "Верстак",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "public/Библиотека",
        "to": "Библиотека"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Верстак",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "Верстак",
      "artifactName": "Верстак-${version}-установщик.${ext}"
    },
    "directories": {
      "output": "release"
    },
    "portable": {
      "artifactName": "Верстак-${version}-portable.${ext}"
    }
  },
  "author": "XLMNR"
}
